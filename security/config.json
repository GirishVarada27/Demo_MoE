{
  "app_name": "MOE certificate equivalency agent",
  "languages": ["python"],
  "source_paths": ["agent", "api", "tools", "ui", "config.py", "schemas.py", "check_azure.py"],
  "config_paths": ["perf", ".env.example"],
  "exclude_paths": [".venv", "tests", "data", "testing", "perf-results", "security-results"],
  "python": {"venv_python": ".venv/Scripts/python.exe", "requirements": ["requirements.txt"]},
  "fail_on": "high",
  "accepted_risks": "security/accepted-risks.json",
  "results_dir": "security-results",
  "base_url": "http://127.0.0.1:{port}",
  "start": {
    "command": [".venv/Scripts/python.exe", "-m", "uvicorn", "api.server:app", "--host", "127.0.0.1", "--port", "{port}", "--no-access-log"],
    "cwd": ".",
    "health_path": "/health",
    "startup_timeout_s": 60,
    "env": {
      "_comment": "Test-only users: token 'sec-APP-001' (user A) and 'sec-APP-002' (user B), valid only in the app process this run starts.",
      "MOE_API_TOKENS": "{\"09256f143376f8e39cf3b88469bd61b94642a61e47b5efa51476d35cb6712626\": \"APP-001\", \"f9566606da17b31bd3e66d46536c59e68a4ab0406d9e9249709f5339a172886f\": \"APP-002\"}"
    }
  },
  "db": {
    "env_var": "MOE_DATA_URL",
    "seed": {
      "copy": [{"from": "data/applicants.json", "to": "applicants.json"}],
      "reset": {"escalation_queue.json": "[]", "draft_applications.json": "[]"}
    }
  },
  "db_guard": {"allowed_schemes": ["file"], "protected_paths": ["data"], "prod_env_vars": ["MOE_DATA_URL"]},
  "llm": {
    "mock": {
      "script": "perf/mock_llm_script.json",
      "env": {
        "AZURE_OPENAI_ENDPOINT": "http://127.0.0.1:{mock_port}",
        "AZURE_OPENAI_API_KEY": "mock-key",
        "AZURE_OPENAI_DEPLOYMENT": "mock-chat",
        "EMBEDDING_DEPLOYMENT": "mock-embedding"
      }
    }
  },
  "dast": {
    "auth_headers": {"Authorization": "Bearer sec-APP-001"},
    "alt_auth_headers": {"Authorization": "Bearer sec-APP-002"},
    "allowed_public_paths": [],
    "endpoints": [
      {
        "name": "chat",
        "method": "POST",
        "path": "/api/v1/chat",
        "body": {"message": "{{input}}"},
        "sample_input": "My applicant ID is APP-001. Can you check my certificate equivalency?",
        "input_field": "message",
        "max_input_chars": 4000,
        "session_scoped": true,
        "session_field": "session_id",
        "session_response_field": "session_id",
        "impact": "any caller can look up any applicant's record, documents and eligibility by applicant ID"
      },
      {"name": "health", "method": "GET", "path": "/health", "public": true},
      {"name": "delete_session", "method": "DELETE", "path": "/api/v1/sessions/{{session}}"}
    ],
    "rate_limit_probe": {
      "endpoint": "chat",
      "requests": 20,
      "impact": "Each chat turn makes several paid model calls, so an unthrottled client can run up provider cost or exhaust the quota for everyone."
    }
  }
}

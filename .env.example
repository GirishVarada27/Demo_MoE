# Azure OpenAI -- set AZURE_OPENAI_ENDPOINT to use this mode for the chat client.
# EMBEDDING_DEPLOYMENT is always required (search_requirements only supports
# Azure OpenAI embeddings, regardless of which chat client mode is active).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
EMBEDDING_DEPLOYMENT=

# Plain OpenAI -- used for the chat client instead, only if AZURE_OPENAI_ENDPOINT
# above is left unset.
OPENAI_API_KEY=
OPENAI_MODEL=
